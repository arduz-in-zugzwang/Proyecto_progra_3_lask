<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E9DDF2"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Texto "Seleccionados para ti" -->
        <TextView
            android:id="@+id/tvSeleccionados"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Seleccionados para ti"
            android:textColor="#3A5BA0"
            android:textStyle="bold"
            android:textSize="16sp"
            android:gravity="end" />

        <!-- Vinilo + imagen destacada -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivVinilo"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:src="@drawable/bg_vinyl" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardDestacado"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">

                <ImageView
                    android:id="@+id/ivDestacado"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/portadadefault"
                    android:contentDescription="Album destacado" />

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- Texto "Nuevos Lanzamientos" -->
        <TextView
            android:id="@+id/tvNuevos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Nuevos Lanzamientos"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:textSize="16sp" />

        <!-- Lista de canciones -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCanciones"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:nestedScrollingEnabled="false" />

        <!-- Texto "Tus Tags" -->
        <TextView
            android:id="@+id/tvTags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Tus Tags"
            android:textColor="#3A5BA0"
            android:textStyle="bold"
            android:textSize="16sp" />

        <!-- Chips de tags: se generan dinámicamente en HomeFragment.kt -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupTags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <!-- Texto "Tus Artistas Favoritos" -->
        <TextView
            android:id="@+id/tvArtistas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Tus Artistas Favoritos"
            android:textColor="#3A5BA0"
            android:textStyle="bold"
            android:textSize="16sp" />

        <!-- Lista de artistas favoritos -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvArtistas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:nestedScrollingEnabled="false" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>