<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E9DDF2"
    android:padding="16dp">

    <!-- Toolbar con el logo en lugar de texto -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        app:cardCornerRadius="30dp"
        app:cardBackgroundColor="#A9CCEB"
        app:cardElevation="0dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:src="@drawable/logolask"
            android:contentDescription="Logo Lask" />

    </com.google.android.material.card.MaterialCardView>

    <!-- Texto "Seleccionados para ti" -->
    <TextView
        android:id="@+id/tvSeleccionados"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Seleccionados para ti"
        android:textColor="#3A5BA0"
        android:textStyle="bold"
        android:textSize="16sp"
        android:layout_marginTop="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar" />

    <!-- Disco de vinilo (placeholder con drawable) -->
    <ImageView
        android:id="@+id/ivVinilo"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/bg_vinyl"
        android:layout_marginTop="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvSeleccionados" />

    <!-- Imagen / album destacado -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardDestacado"
        android:layout_width="0dp"
        android:layout_height="100dp"
        android:layout_marginStart="12dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:layout_constraintStart_toEndOf="@id/ivVinilo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/ivVinilo">

        <ImageView
            android:id="@+id/ivDestacado"
            android:layout_width="119dp"
            android:layout_height="match_parent"
            android:contentDescription="Album destacado"
            android:scaleType="centerCrop"
            android:src="@drawable/portadadefault" />

    </com.google.android.material.card.MaterialCardView>

    <!-- Texto "Nuevos Lanzamientos" -->
    <TextView
        android:id="@+id/tvNuevos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nuevos Lanzamientos"
        android:textColor="#3A5BA0"
        android:textStyle="bold"
        android:textSize="16sp"
        android:layout_marginTop="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ivVinilo" />

    <!-- Lista de canciones -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCanciones"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvNuevos"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
