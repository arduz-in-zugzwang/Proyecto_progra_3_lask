<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/discocelestee"
    tools:context=".Bienvenido">

    <ImageView
        android:id="@+id/imgLogo"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="16dp"
        android:contentDescription="Logo de Lask"
        android:src="@drawable/logolask" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="329dp"
        android:layout_weight="1"
        android:fontFamily="@font/schoolbell"
        android:gravity="bottom|center_horizontal"
        android:text="Bienvenido a Lask"
        android:textColor="@color/white"
        android:textSize="60dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="top|center_horizontal"
        android:layout_marginTop="16dp"
        android:layout_weight="4"
        android:orientation="horizontal">
        <Button
            android:id="@+id/btnInciar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/tag_celeste"
            android:textColor="@color/black"
            android:fontFamily="@font/schoolbell"
            android:text="Iniciar Sesion"/>
        <Button
            android:id="@+id/btnCrearCuenta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/tag_celeste"
            android:textColor="@color/black"
            android:fontFamily="@font/schoolbell"
            android:text="Crear Cuenta"/>
    </LinearLayout>

</LinearLayout>