<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#547daf"
    tools:context=".CrearPlaylist">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- TOOLBAR -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbarLogin"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:background="#547daf"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/imageView"
                    android:layout_width="100dp"
                    android:layout_height="match_parent"
                    android:contentDescription="Logo LASK"
                    app:srcCompat="@drawable/logito" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <ImageView
                    android:id="@+id/imgPerfil"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="12dp"
                    android:scaleType="centerCrop" />

            </LinearLayout>
        </com.google.android.material.appbar.MaterialToolbar>

        <!-- TITULO -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="35dp"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif-medium"
            android:text="Crear Playlist"
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/toolbarLogin" />

        <!-- CARD -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardCrearPlaylist"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="35dp"
            android:layout_marginEnd="35dp"
            android:layout_marginTop="60dp"
            android:layout_marginBottom="60dp"
            app:cardBackgroundColor="#a3c7f4"
            app:cardCornerRadius="14dp"
            app:cardElevation="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/toolbarLogin"
            app:layout_constraintVertical_bias="0.4">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="45dp">

                <!-- LABEL PORTADA -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="+ Insertar portada"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <!-- PORTADA + NOMBRE -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="90dp"
                        android:layout_height="100dp"
                        android:layout_marginEnd="10dp"
                        android:background="@drawable/borde_redondeado"
                        android:clipToOutline="true">

                        <ImageButton
                            android:id="@+id/cambiarPortada"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@null"
                            android:scaleType="centerCrop"
                            android:adjustViewBounds="false" />

                    </FrameLayout>

                    <EditText
                        android:id="@+id/etNombrePlaylist"
                        android:layout_width="match_parent"
                        android:layout_height="30dp"
                        android:background="#FFFFFF"
                        android:hint="Nombre de la playlist"
                        android:inputType="text"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:textColor="#000000"
                        android:textColorHint="#888888"
                        android:textSize="13sp" />

                </LinearLayout>

                <!-- CANCIONES + VISIBILIDAD -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:orientation="horizontal">

                    <!-- Lista canciones -->
                    <ScrollView
                        android:layout_width="100dp"
                        android:layout_height="120dp"
                        android:background="#FFFFFF">

                        <LinearLayout
                            android:id="@+id/listaCanciones"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="8dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Canciones agregadas"
                                android:textColor="#AAAAAA"
                                android:textSize="11sp" />

                        </LinearLayout>

                    </ScrollView>

                    <!-- Visibilidad -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <Button
                            android:id="@+id/btnInsertarCanciones"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="10dp"
                            android:backgroundTint="#FFFFFF"
                            android:text="+ Canciones"
                            android:textColor="#888888"
                            android:textSize="11sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="6dp"
                            android:text="Visibilidad"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/btnPublica"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:layout_marginEnd="6dp"
                                android:backgroundTint="#FFFFFF"
                                android:paddingStart="10dp"
                                android:paddingEnd="10dp"
                                android:text="Pública"
                                android:textColor="#888888"
                                android:textSize="11sp" />

                            <Button
                                android:id="@+id/btnPrivada"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:backgroundTint="#FFFFFF"
                                android:paddingStart="10dp"
                                android:paddingEnd="10dp"
                                android:text="Privada"
                                android:textColor="#888888"
                                android:textSize="11sp" />

                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- BOTON CREAR -->
                <Button
                    android:id="@+id/btnCrearPlaylist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:backgroundTint="#FFFFFF"
                    android:paddingStart="32dp"
                    android:paddingEnd="32dp"
                    android:text="Crear playlist"
                    android:textColor="#888888" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>