<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#547daf"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- TOOLBAR -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbarCrearLetras"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:background="#2D2D2D"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="70dp"
                    android:layout_height="50dp"
                    android:src="@drawable/logito" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <ImageView
                    android:id="@+id/imgPerfilCrearLetras"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:scaleType="centerCrop"/>
            </LinearLayout>
        </com.google.android.material.appbar.MaterialToolbar>

        <!-- TITULO -->
        <TextView
            android:id="@+id/tvTituloCrearLetras"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Agregar Letra"
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold"
            android:layout_marginStart="35dp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/toolbarCrearLetras"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- CARD -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardCrearLetras"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="35dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="#a3c7f4"
            app:layout_constraintTop_toBottomOf="@id/tvTituloCrearLetras"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">



                <!-- LETRA -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="4dp"
                    android:text="Letra"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold"/>

                <EditText
                    android:id="@+id/etLetraContenido"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:background="#FFFFFF"
                    android:gravity="top"
                    android:hint="Ingrese la letra aquí..."
                    android:padding="10dp"
                    android:textColor="#000000"
                    android:textSize="14sp"
                    android:inputType="textMultiLine"
                    android:scrollbars="vertical"/>

                <!-- LETRA FONETICA -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="4dp"
                    android:text="Letra Fonética"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold"/>

                <EditText
                    android:id="@+id/etLetraFoneticaContenido"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:background="#FFFFFF"
                    android:gravity="top"
                    android:hint="Ingrese la letra fonética aquí..."
                    android:padding="10dp"
                    android:textColor="#000000"
                    android:textSize="14sp"
                    android:inputType="textMultiLine"
                    android:scrollbars="vertical"/>


            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <Button
            android:id="@+id/btnSubirLetraAccion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Subir Letra"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="48dp"
            android:backgroundTint="#2D2D2D"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            app:layout_constraintTop_toBottomOf="@id/cardCrearLetras"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>