<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="60dp"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="30dp"
    app:cardBackgroundColor="#A9CCEB"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="6dp">

        <!-- Avatar circular -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp">

            <ImageView
                android:id="@+id/ivAvatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/artistadefault"
                android:contentDescription="Avatar artista" />

        </com.google.android.material.card.MaterialCardView>

        <!-- Nombre del artista -->
        <TextView
            android:id="@+id/tvNombreArtista"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="Nombre del artista"
            android:textColor="@color/black"
            android:fontFamily="@font/schoolbell_regular"
            android:textSize="15sp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
